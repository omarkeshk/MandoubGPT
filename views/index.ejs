<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>MandoubGPT - Sophomore Mechanical Assistant</title>
		<style>
			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
				font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
			}

			body {
				background: #f0f2f5;
				min-height: 100vh;
			}

			.chat-container {
				max-width: 800px;
				margin: 2rem auto;
				background: white;
				border-radius: 15px;
				box-shadow: 0 2px 15px rgba(0, 0, 0, 0.1);
				overflow: hidden;
			}

			.chat-header {
				background: linear-gradient(135deg, #2c3e50, #3498db);
				color: white;
				padding: 1.5rem;
				text-align: center;
			}

			.chat-header h1 {
				font-size: 1.8rem;
				margin-bottom: 0.5rem;
			}

			.chat-messages {
				height: 500px;
				overflow-y: auto;
				padding: 1.5rem;
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}

			.message {
				max-width: 70%;
				padding: 1rem;
				border-radius: 15px;
				animation: fadeIn 0.3s ease-in;
			}

			.user-message {
				background: #3498db;
				color: white;
				margin-left: auto;
			}

			.bot-message {
				background: #f0f0f0;
				margin-right: auto;
			}

			.input-container {
				padding: 1.5rem;
				background: #f8f9fa;
				display: flex;
				gap: 1rem;
			}

			input[type="text"] {
				flex: 1;
				padding: 1rem;
				border: none;
				border-radius: 10px;
				font-size: 1rem;
				background: white;
				box-shadow: 0 2px 5px rgba(0, 0, 0, 0.05);
			}

			button {
				padding: 1rem 2rem;
				border: none;
				border-radius: 10px;
				background: #3498db;
				color: white;
				cursor: pointer;
				transition: background 0.3s ease;
			}

			button:hover {
				background: #2980b9;
			}

			.typing-indicator {
				display: none;
				padding: 1rem;
				background: #f0f0f0;
				border-radius: 15px;
				width: fit-content;
				margin: 0.5rem 0;
			}

			.typing-dots {
				display: flex;
				gap: 0.3rem;
			}

			.typing-dot {
				width: 8px;
				height: 8px;
				background: #999;
				border-radius: 50%;
				animation: typing 1.4s infinite;
			}

			@keyframes fadeIn {
				from {
					opacity: 0;
					transform: translateY(10px);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}

			@keyframes typing {
				0%,
				100% {
					transform: translateY(0);
				}
				50% {
					transform: translateY(-5px);
				}
			}

			@media (max-width: 768px) {
				.chat-container {
					margin: 0;
					border-radius: 0;
					height: 100vh;
				}
				.chat-messages {
					height: calc(100vh - 160px);
				}
			}

			@media (max-width: 768px) {
				.chat-container {
					margin: 0;
					border-radius: 0;
					height: 100vh;
					width: 100%;
				}

				.chat-messages {
					height: calc(100vh - 160px);
					padding: 1rem;
				}

				.message {
					max-width: 85%;
					padding: 0.8rem;
					font-size: 0.9rem;
				}

				.chat-header {
					padding: 1rem;
				}

				.chat-header h1 {
					font-size: 1.5rem;
				}

				.input-container {
					padding: 1rem;
					flex-direction: column;
				}

				input[type="text"] {
					padding: 0.8rem;
					width: 100%;
				}

				button {
					width: 100%;
					padding: 0.8rem;
				}

				/* Mobile-specific adjustments */
				@media (max-width: 480px) {
					.message {
						max-width: 90%;
						padding: 0.7rem;
					}

					.chat-header h1 {
						font-size: 1.3rem;
					}

					.chat-header p {
						font-size: 0.9rem;
					}

					.typing-indicator {
						padding: 0.7rem;
					}
				}
			}

			/* Footer styling */
			footer {
				text-align: center;
				padding: 1rem;
				font-size: 0.2rem;
				background: #f8f9fa;
				color: #333;
			}

			/* Smooth transitions for mobile interactions */
			button:active {
				transform: scale(0.98);
				transition: transform 0.1s ease;
			}

			input[type="text"]:focus {
				outline: 2px solid #3498db;
				outline-offset: -2px;
			}
		</style>
		<script>
			const CLIENT_URL = "<%= clientUrl %>"
		</script>
	</head>
	<body>
		<div class="chat-container">
			<div class="chat-header">
				<h1>MandoubGPT</h1>
				<p>Your ASU sophomore mechanical assistant</p>
			</div>
			<div class="chat-messages" id="chat-messages">
				<div class="message bot-message">
					Hello! I'm MandoubGPT, your ASU sophomore mechanical
					assistant. How can I help you today?
				</div>
			</div>
			<div class="typing-indicator" id="typing-indicator">
				<div class="typing-dots">
					<div class="typing-dot" style="animation-delay: 0s"></div>
					<div class="typing-dot" style="animation-delay: 0.2s"></div>
					<div class="typing-dot" style="animation-delay: 0.4s"></div>
				</div>
			</div>
			<div class="input-container">
				<input
					dir="rtl"
					type="text"
					id="user-input"
					placeholder="اسأل عن اللي انت عايز تعرفه"
				/>
				<button onclick="sendMessage()">Send</button>
			</div>
		</div>

		<footer>
			<div
				class="footer-content"
				style="
					text-align: center;
					background: #f8f9fa;
					color: #333;
					font-size: 0.6rem;
				"
			>
				&copy; <%= new Date().getFullYear() %> MandoubGPT. All rights
				reserved.

				<br />
				Developed by Omar Keshk
			</div>
		</footer>

		<script>
			const OPENAI_API_KEY = "YOUR_API_KEY" // Replace with your API key
			const chatMessages = document.getElementById("chat-messages")
			const userInput = document.getElementById("user-input")
			const typingIndicator = document.getElementById("typing-indicator")

			async function sendMessage() {
				const message = userInput.value.trim()
				if (!message) return

				// Add user message
				addMessage(message, "user")
				userInput.value = ""

				// Show typing indicator
				typingIndicator.style.display = "block"

				try {
					const response = await fetch(`${CLIENT_URL}/api/chat`, {
						method: "POST",
						headers: {
							"Content-Type": "application/json",
						},
						body: JSON.stringify({
							message,
							previousChat: Array.from(
								chatMessages.querySelectorAll(".message")
							).map((msg) => {
								return {
									sender: msg.classList.contains(
										"user-message"
									)
										? "user"
										: "bot",
									text: msg.textContent.trim(),
								}
							}),
						}),
					})
					const data = await response.json()
					const botResponse = data.message
					// Add bot response
					const formattedResponse = botResponse.replace(
						/(?:\()?(https?:\/\/[^\s\)]+)(?:\))?/g,
						(match, p1) =>
							`<a href="${p1}" target="_blank">${p1}</a>`
					)
					addMessage(
						`<span dir="auto">${formattedResponse}</span>`,
						"bot"
					)
				} catch (error) {
					addMessage(
						"معلش حصل مشكلة, احتمال يكون عليا ضغط كبير بس, حاول مرة تانية.",
						"bot"
					)
				}

				// Hide typing indicator
				typingIndicator.style.display = "none"
			}

			function addMessage(content, sender) {
				const messageDiv = document.createElement("div")
				messageDiv.classList.add("message", `${sender}-message`)
				messageDiv.innerHTML = content
				chatMessages.appendChild(messageDiv)
				chatMessages.scrollTop = chatMessages.scrollHeight
			}

			// Handle Enter key
			userInput.addEventListener("keypress", (e) => {
				if (e.key === "Enter") sendMessage()
			})
		</script>
	</body>
</html>
