<!DOCTYPE html>
<html lang="ar" dir="auto">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>MandoubGPT - Sophomore Mechanical Assistant</title>
		<script>
			const CLIENT_URL = "<%= CLIENT_URL %>"
		</script>
		<link
			href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&family=Cairo:wght@400;600&display=swap"
			rel="stylesheet"
		/>
		<link
			rel="stylesheet"
			href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
		/>
		<style>
			:root {
				--primary-color: #1a1d24;
				--secondary-color: #252932;
				--accent-color: #d4af37;
				--text-primary: #f0f3f5;
				--text-secondary: #9ba7b3;
				--gradient: linear-gradient(135deg, #d4af37 0%, #c19b52 100%);
			}
			* {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
				font-family: "Poppins", "Cairo", system-ui, sans-serif;
				unicode-bidi: plaintext;
			}
			body {
				background: var(--primary-color);
				color: var(--text-primary);
				min-height: 100dvh;
				display: flex;
				flex-direction: column;
			}
			.chat-container {
				max-width: 1400px;
				margin: 2rem auto;
				border-radius: 1.5rem;
				overflow: hidden;
				background: var(--secondary-color);
				box-shadow: 0 1rem 4rem rgba(0, 0, 0, 0.4);
				height: calc(100vh - 8rem);
				display: flex;
				flex-direction: column;
				border: 1px solid rgba(255, 255, 255, 0.05);
			}
			.chat-header {
				background: linear-gradient(
					135deg,
					rgba(33, 33, 33, 0.9) 0%,
					rgba(42, 42, 42, 0.9) 100%
				);
				padding: 0.5rem 2rem 0;
				border-bottom: 1px solid rgba(255, 255, 255, 0.08);
				backdrop-filter: blur(8px);
				display: flex;
				justify-content: space-between;
				align-items: center;
				position: relative;
				flex-wrap: wrap;
			}
			@media (max-width: 768px) {
				.chat-header > * {
					/* flex: 0 0 50%; */
					text-align: center;
					justify-content: center;
					align-items: center;
					margin-bottom: 1rem;
				}
				h1 {
					margin: auto;
				}
			}
			.chat-header h1 {
				font-size: 1.8rem;
				font-weight: 600;
				background: var(--gradient);
				-webkit-background-clip: text;
				background-clip: text;
				-webkit-text-fill-color: transparent;
				letter-spacing: -0.5px;
			}
			.chat-messages {
				flex: 1;
				padding: 2rem;
				overflow-y: auto;
				display: flex;
				flex-direction: column;
				gap: 1.5rem;
				background: radial-gradient(
					circle at 50% 0%,
					rgba(212, 175, 55, 0.03) 0%,
					transparent 100%
				);
				scroll-behavior: smooth;
			}
			/* WebKit scrollbar styles */
			.chat-messages::-webkit-scrollbar {
				width: 8px;
			}
			.chat-messages::-webkit-scrollbar-track {
				background: rgba(0, 0, 0, 0.1);
				border-radius: 4px;
			}
			.chat-messages::-webkit-scrollbar-thumb {
				background: var(--accent-color);
				border-radius: 4px;
			}
			.chat-messages::-webkit-scrollbar-thumb:hover {
				background: var(--secondary-color);
			}
			.message {
				max-width: 75%;
				padding: 1.25rem 1.75rem;
				border-radius: 1.25rem;
				animation: messageAppear 0.4s
					cubic-bezier(0.175, 0.885, 0.32, 1.275);
				position: relative;
				line-height: 1.6;
				unicode-bidi: plaintext;
				direction: auto;
				border: 1px solid rgba(255, 255, 255, 0.06);
				backdrop-filter: blur(4px);
				overflow-wrap: anywhere;
			}
			.user-message {
				align-self: flex-end;
				background: linear-gradient(
					135deg,
					rgba(212, 175, 55, 0.15) 0%,
					rgba(193, 155, 82, 0.1) 100%
				);
				border-radius: 1.25rem 1.25rem 0.25rem 1.25rem;
				border: 1px solid rgba(212, 175, 55, 0.15);
			}
			.bot-message {
				align-self: flex-start;
				background: rgba(25, 28, 34, 0.8);
				border-radius: 0.25rem 1.25rem 1.25rem 1.25rem;
			}
			.input-container {
				padding: 0.5rem 2rem;
				background: rgba(22, 25, 30, 0.9);
				border-top: 1px solid rgba(255, 255, 255, 0.08);
				backdrop-filter: blur(8px);
			}
			.input-wrapper {
				display: flex;
				gap: 1rem;
				position: relative;
			}
			input {
				flex: 1;
				padding: 1.25rem 1.5rem;
				border: none;
				border-radius: 1rem;
				background: rgba(35, 38, 45, 0.8);
				color: var(--text-primary);
				font-size: 1rem;
				direction: auto;
				unicode-bidi: plaintext;
				transition: all 0.3s ease;
				min-height: 56px;
				border: 1px solid transparent;
				direction: rtl;
			}
			input:focus {
				outline: none;
				border: 1px solid var(--accent-color);
				box-shadow: 0 0 1rem rgba(212, 175, 55, 0.15);
			}
			input::placeholder {
				color: var(--text-secondary);
				opacity: 0.8;
			}
			button {
				padding: 0 1.5rem;
				border: none;
				border-radius: 1rem;
				background: var(--gradient);
				color: white;
				cursor: pointer;
				transition: all 0.3s ease;
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 0.75rem;
				font-weight: 500;
				position: relative;
				overflow: hidden;
				/* min-width: 100px; */
				min-height: 56px;
				margin: auto;
			}
			button::after {
				content: "";
				position: absolute;
				top: 0;
				left: -100%;
				width: 100%;
				height: 100%;
				background: linear-gradient(
					90deg,
					transparent,
					rgba(255, 255, 255, 0.1),
					transparent
				);
				transition: 0.5s;
			}
			button:hover::after {
				left: 100%;
			}
			button:hover {
				transform: translateY(-1px);
				box-shadow: 0 0.5rem 1.5rem rgba(212, 175, 55, 0.2);
			}
			@keyframes messageAppear {
				0% {
					opacity: 0;
					transform: translateY(1rem) scale(0.95);
				}
				100% {
					opacity: 1;
					transform: translateY(0) scale(1);
				}
			}
			footer {
				background: var(--secondary-color);
				padding: 1rem 2rem;
				text-align: center;
				font-size: 0.9rem;
				border-top: 1px solid rgba(255, 255, 255, 0.06);
				padding: 0.5rem;
			}
			@media (max-width: 768px) {
				.chat-container {
					margin: 0;
					/* height: calc(100vh - 2rem); */
					border-radius: 0;
					height: 100dvh;
				}
				.message {
					max-width: 90%;
					padding: 1rem 1.25rem;
				}
				input {
					padding: 1rem;
				}
				.hide-on-small {
					display: none;
				}
			}
			/* Add typing indicator styles */
			.typing-indicator {
				display: inline-flex;
				align-items: center;
				padding: 1rem 1.75rem;
			}
			.typing-dot {
				width: 8px;
				height: 8px;
				margin: 0 3px;
				background: var(--text-secondary);
				border-radius: 50%;
				animation: typing 1.4s infinite ease-in-out;
			}
			.typing-dot:nth-child(2) {
				animation-delay: 0.2s;
			}
			.typing-dot:nth-child(3) {
				animation-delay: 0.4s;
			}
			@keyframes typing {
				0%,
				80%,
				100% {
					transform: translateY(0);
				}
				40% {
					transform: translateY(-8px);
				}
			}
			a {
				text-decoration: none;
				color: var(--accent-color);
			}
			.disclaimer-modal,
			.customization-modal {
				display: flex;
				justify-content: center;
				align-items: center;
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				background: rgba(0, 0, 0, 0.5);
				z-index: 1000;
				text-align: center;
			}
			.customization-content {
				background: var(--secondary-color);
				padding: 2rem;
				border-radius: 1rem;
				min-width: 300px;
				max-width: 90%;
			}
			.customization-content label {
				display: block;
				margin: 0.5rem 0 0.25rem;
			}
			.customization-content input {
				min-width: 30vw;
				width: 100%;
				margin-bottom: 1rem;
				padding: 0.5rem;
				border-radius: 0.5rem;
				border: 1px solid var(--accent-color);
				background: transparent;
				color: var(--text-primary);
			}
			#open-customization-btn {
				padding: 0 1.5rem;
				background: none;
				border: none;
				color: var(--accent-color);
				font-size: 1.5rem;
			}
			#open-customization-btn:hover {
				cursor: pointer;
			}

			@media (max-width: 768px) {
				#open-customization-btn {
					position: absolute;
					top: 10px;
					right: 10px;
					font-size: 1.25rem;
				}
			}
			select {
				width: 100%;
				padding: 0.5rem;
				border-radius: 0.5rem;
				border: 1px solid var(--accent-color);
				background: transparent;
			}
			select option:checked {
				color: var(--text-primary);
			}
			#custom-section {
				color: var(--text-primary);
			}
			option {
				color: var(--secondary-color);
				direction: rtl;
			}
		</style>
	</head>
	<body>
		<!-- <div id="disclaimer-modal" class="disclaimer-modal">
			<div class="disclaimer-content">
				<p>المندوب تحت الصيانة.</p>
				<button
					id="close-disclaimer"
					style="display: block; margin: 0 auto"
				>
					تمام
				</button>
			</div>
		</div> -->

		<!-- Customization Modal -->
		<div
			id="customization-modal"
			class="customization-modal"
			style="display: none"
		>
			<div class="customization-content">
				<h2>Customize</h2>
				<label for="custom-section">السكشن:</label>
				<select id="custom-section">
					<option value="general">جينيرال</option>
					<option value="1">سكشن 1</option>
					<option value="2">سكشن 2</option>
					<option value="3">سكشن 3</option>
					<option value="4">سكشن 4</option>
				</select>
				<label for="custom-name">الاسم:</label>
				<input
					type="text"
					id="custom-name"
					placeholder="اكتب اسمك لو حابب يكلمك باسمك"
				/>
				<label for="custom-message" dir="ltr">رسالة صغيرة:</label>
				<input
					type="text"
					id="custom-message"
					maxlength="50"
					placeholder="اكتب أي حاجة مميزة حابب إنه يعملها في الردود"
				/>
				<button id="close-customization" style="display: inline-block">
					Close
				</button>
				<button
					id="save-customization"
					style="display: inline-block; margin-right: 1rem"
				>
					Save
				</button>
			</div>
		</div>

		<div class="chat-container">
			<div class="chat-header">
				<h1>MandoubGPT</h1>
				<!-- Customize Button -->

				<p class="university-badge" style="text-align: center">
					Your ASU sophomore mechanical assistant
				</p>
				<div id="open-customization-btn">
					<i class="fas fa-cog"></i>
				</div>
			</div>
			<div class="chat-messages" id="chat-messages">
				<div class="message bot-message">
					Hello! I'm MandoubGPT, your ASU sophomore mechanical
					assistant. How can I help you today?
				</div>
			</div>
			<div class="input-container">
				<div class="input-wrapper">
					<input
						type="text"
						id="user-input"
						placeholder="اسأل عن اللي انت عايز تعرفه"
						style="width: 100px"
					/>
					<button onclick="sendMessage()">
						<i class="fas fa-paper-plane"></i>
						<span class="text hide-on-small">Send</span>
					</button>
				</div>
			</div>
			<footer>
				© 2025 MandoubGPT. All rights reserved.
				<br />
				Developed by
				<a href="https://wa.me/201014078364" target="_blank">
					Omar Keshk</a
				>
			</footer>
		</div>
		<script>
			// Chat functionality (unchanged)
			const chatMessages = document.getElementById("chat-messages")
			const userInput = document.getElementById("user-input")
			let messageHistory = []
			let historyIndex = -1

			userInput.addEventListener("keydown", (e) => {
				if (e.key === "ArrowUp" && messageHistory.length > 0) {
					e.preventDefault()
					historyIndex = Math.max(historyIndex - 1, 0)
					userInput.value = messageHistory[historyIndex]
				} else if (e.key === "ArrowDown" && messageHistory.length > 0) {
					e.preventDefault()
					historyIndex = Math.min(
						historyIndex + 1,
						messageHistory.length - 1
					)
					userInput.value = messageHistory[historyIndex] || ""
				} else if (e.key === "Enter") {
					e.preventDefault()
					sendMessage()
				}
			})

			async function sendMessage() {
				const message = userInput.value.trim()
				if (!message) return

				messageHistory.unshift(message)
				historyIndex = -1

				addMessage(message, "user")
				userInput.value = ""
				showTypingIndicator()

				try {
					const customization = localStorage.getItem("customization")
						? JSON.parse(localStorage.getItem("customization"))
						: undefined

					const response = await fetch(`${CLIENT_URL}/api/acu`, {
						method: "POST",
						headers: {
							"Content-Type": "application/json",
						},
						body: JSON.stringify({
							message,
							previousChat: Array.from(
								chatMessages.querySelectorAll(".message")
							).map((msg) => {
								return {
									sender: msg.classList.contains(
										"user-message"
									)
										? "user"
										: "bot",
									text: msg.textContent.trim(),
								}
							}),
							customization,
						}),
					})
					const data = await response.json()
					const botResponse = data.message
					const formattedResponse = botResponse
						.replace(/^######\s*(.+)$/gm, "<h6>$1</h6>")
						.replace(/^#####\s*(.+)$/gm, "<h5>$1</h5>")
						.replace(/^####\s*(.+)$/gm, "<h4>$1</h4>")
						.replace(/^###\s*(.+)$/gm, "<h3>$1</h3>")
						.replace(/^##\s*(.+)$/gm, "<h2>$1</h2>")
						.replace(/^#\s*(.+)$/gm, "<h1>$1</h1>")
						.replace(/\*\*\*\*(.*?)\*\*\*\*/g, "<b>$1</b>")
						.replace(/\*\*(.*?)\*\*/g, "<b>$1</b>")
						.replace(
							/(?:\()?(\[?https?:\/\/[^\s\)\]]+\]?)(?:\))?/g,
							(match, p1) => {
								let url = p1
								if (url.startsWith("[")) url = url.substring(1)
								if (url.endsWith("]"))
									url = url.substring(0, url.length - 1)
								return `<div><a href="${url}" target="_blank">${url}</a></div>`
							}
						)
					if (data.error) {
						console.error(data.error)
					}
					addMessage(
						`<span dir="auto">${formattedResponse}</span>`,
						"bot"
					)
				} catch (error) {
					addMessage("في حاجة غلط حصلت, معلش جرب تاني.", "bot")
					console.error(error)
				}
				hideTypingIndicator()
			}

			function addMessage(text, sender) {
				const messageDiv = document.createElement("div")
				messageDiv.className = `message ${sender}-message`
				messageDiv.innerHTML = text
					.replace(/<\/?span[^>]*>/g, "")
					.replace(/\n/g, "<br>")
				// Replace the original text with the plain text content for copying
				text = messageDiv.innerText

				if (sender === "bot") {
					const copyButton = document.createElement("i")
					copyButton.className = "fas fa-copy"
					copyButton.style.position = "absolute"
					copyButton.style.position = "fixed"
					const rect = messageDiv.getBoundingClientRect()
					copyButton.style.top = rect.top + rect.height / 2 + "px"
					copyButton.style.right = -rect.left - 8 + "px"
					copyButton.style.transform = "translateY(-50%)"
					copyButton.style.background = "transparent"
					copyButton.style.border = "none"
					copyButton.style.color = "var(--text-secondary)"
					copyButton.style.cursor = "pointer"
					copyButton.addEventListener("click", () => {
						navigator.clipboard
							.writeText(text)
							.then(() => {
								copyButton.textContent = "Copied!"
								setTimeout(() => {
									copyButton.textContent = ""
								}, 2000)
							})
							.catch((err) => {
								console.error("Failed to copy: ", err)
							})
					})
					messageDiv.appendChild(copyButton)
				}

				chatMessages.appendChild(messageDiv)
				chatMessages.scrollTop = chatMessages.scrollHeight
			}

			let isBotTyping = false
			function showTypingIndicator() {
				if (isBotTyping) return
				const typingDiv = document.createElement("div")
				typingDiv.className = "message bot-message typing-indicator"
				typingDiv.innerHTML = `
                    <div class="typing-dot"></div>
                    <div class="typing-dot"></div>
                    <div class="typing-dot"></div>
                `
				chatMessages.appendChild(typingDiv)
				chatMessages.scrollTop = chatMessages.scrollHeight
				isBotTyping = true
			}
			function hideTypingIndicator() {
				const typingIndicator =
					document.querySelector(".typing-indicator")
				if (typingIndicator) {
					typingIndicator.remove()
					isBotTyping = false
				}
			}

			// Disclaimer modal functionality
			// document
			// 	.getElementById("close-disclaimer")
			// 	.addEventListener("click", function () {
			// 		document.getElementById("disclaimer-modal").style.display =
			// 			"none"
			// 	})

			// Customization modal functionality
			const customizationModal = document.getElementById(
				"customization-modal"
			)
			document
				.getElementById("open-customization-btn")
				.addEventListener("click", () => {
					customizationModal.style.display = "flex"
					// Pre-fill fields if already stored
					const savedCustomization = JSON.parse(
						localStorage.getItem("customization") || "{}"
					)
					if (savedCustomization.customName) {
						document.getElementById("custom-name").value =
							savedCustomization.customName
					}
					if (savedCustomization.customMessage) {
						document.getElementById("custom-message").value =
							savedCustomization.customMessage
					}
					if (savedCustomization.customSection) {
						document.getElementById("custom-section").value =
							savedCustomization.customSection
					}
				})
			document
				.getElementById("close-customization")
				.addEventListener("click", () => {
					customizationModal.style.display = "none"
				})
			document
				.getElementById("save-customization")
				.addEventListener("click", () => {
					const customName = document
						.getElementById("custom-name")
						.value.trim()
					const customMessage = document
						.getElementById("custom-message")
						.value.trim()
					const customSection =
						document.getElementById("custom-section").value
					const customization = {
						customName: customName,
						customMessage: customMessage,
						customSection: customSection,
					}
					localStorage.setItem(
						"customization",
						JSON.stringify(customization)
					)
					customizationModal.style.display = "none"
				})

			document.getElementById("user-input").value = ""
			document.getElementById("user-input").focus()
			if (!localStorage.getItem("customization")) {
				document.getElementById("customization-modal").style.display =
					"flex"
			}
		</script>
	</body>
</html>
